# loto-5dr1: a session releases its own locks across worktrees.
#
# One session (owner $ALICE, session sess-root) runs Agent subagents with
# `isolation: worktree`: Claude Code puts their checkouts INSIDE the main one,
# at .claude/worktrees/agent-<id>, and their writes take locks under the
# session's own ids, stamped with the subagent's checkout. From the main
# checkout, one `loto unlock --all` releases them all.

exec git commit --allow-empty -m seed
exec git worktree add -q $WORK/.claude/worktrees/agent-a -b agent-a
exec git worktree add -q $WORK/.claude/worktrees/agent-b -b agent-b

env LOTO_AGENT_ID=$ALICE
env CLAUDE_CODE_SESSION_ID=sess-root
env CLAUDE_CODE_CHILD_SESSION=1

# ── 1. the root session, from the main checkout, releases its subagents' ──
cd $WORK/.claude/worktrees/agent-a
touch a.go
loto lock a.go -t 'hook: admitted Edit-family write'
cd $WORK/.claude/worktrees/agent-b
touch b.go
loto lock b.go -t 'hook: admitted Edit-family write'
cd $WORK
touch c.go
env CLAUDE_CODE_CHILD_SESSION=
loto lock c.go -t 'root work'

loto unlock --all
stdout 'count=3'
stdout '^✓ target=a.go worktree=worktrees/agent-a$'
stdout '^✓ target=b.go worktree=worktrees/agent-b$'
stdout '^✓ target=c.go$'
loto status
! stdout 'a.go|b.go|c.go'

# ── 4. --force --expect-holder breaks a holder status shows elsewhere ─────
cd $WORK/.claude/worktrees/agent-a
loto lock a.go -t 'hook: admitted Edit-family write'
cd $WORK
exec sh $WORK/break.sh a.go
stdout '✓ broken'
! stderr 'holder-changed'
loto status
! stdout 'a\.go'

# Named holders in two other checkouts are two breaks: refused, with one
# runnable break per checkout carrying that checkout's real holder token.
cd $WORK/.claude/worktrees/agent-a
loto lock a.go -t 'hook: admitted Edit-family write'
cd $WORK/.claude/worktrees/agent-b
touch a.go
loto lock a.go -t 'hook: admitted Edit-family write'
cd $WORK
! exec sh $WORK/break-all.sh a.go
stderr 'expect-holder-split count=2'
! stderr '<'
cp stderr $WORK/.git/split-refusal.txt
exec sh $WORK/run-fix.sh $WORK/.git/split-refusal.txt
stdout '✓ broken'
loto status
! stdout 'a\.go'

# A holder in this checkout plus one in a subagent's: also a split, both
# breaks printed and both run.
loto lock a.go -t 'root work'
cd $WORK/.claude/worktrees/agent-a
loto lock a.go -t 'hook: admitted Edit-family write'
cd $WORK
! exec sh $WORK/break-all.sh a.go
stderr 'expect-holder-split count=2'
cp stderr $WORK/.git/own-split-refusal.txt
exec sh $WORK/run-fix.sh $WORK/.git/own-split-refusal.txt
loto status
! stdout 'a\.go'

-- run-fix.sh --
# Pull the ```bash block out of a captured refusal and run it as printed.
sed -n '/^```bash$/,/^```$/p' "$1" | sed '1d;$d' >"$1.sh"
sh -e "$1.sh"
-- break.sh --
# Read the holder token off `loto status` the way an agent would, then break.
tok=$(loto status "$1" | sed -n 's/.*owner=\([^ ]*\) epoch=\([0-9]*\).*/\1@\2/p' | head -n 1)
loto unlock "$1" --force -t 'subagent finished' --expect-holder "$tok"
-- break-all.sh --
# Every holder token status prints for the path, stated in one break.
set --  "$1" $(loto status "$1" | sed -n 's/.*owner=\([^ ]*\) epoch=\([0-9]*\).*/--expect-holder \1@\2/p')
loto unlock "$@" --force -t 'subagents finished'
