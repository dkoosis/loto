# .githooks/hooks.d/post-checkout/10-loto-moved-locks (loto-ea8y.2): a branch
# switch that rewrites a path a live peer holds still SUCCEEDS, and prints one
# ⚠ row naming the path and the holder. git has no pre-checkout hook, so by
# the time anything can run the tree is already rewritten; advisory is the
# only honest shape.
#
# End-to-end through the real dispatcher and a real `git checkout`.

exec git config core.hooksPath $REALHOOKS

# Seed two branches that differ in shared.go. LOTO_GUARD_OVERRIDE keeps the
# pre-commit guard out of the fixture — this script is about post-checkout.
env LOTO_GUARD_OVERRIDE=1
env LOTO_AGENT_ID=$BOB
touch shared.go
exec git add shared.go
exec git commit -m 'seed'
exec git checkout -b other
cp v2.txt shared.go
exec git add shared.go
exec git commit -m 'other: rewrites shared.go'

# No peer lock anywhere: the checkout says nothing at all.
env LOTO_GUARD_OVERRIDE=
exec git checkout -
! stderr 'moved-peer-locks'

# Alice takes a shared lock — a read declaration, so the write bit stays on
# and git can still rewrite the file underneath her. That is the point.
env LOTO_AGENT_ID=$ALICE
loto lock shared.go --shared -t 'alice reading'
stdout '✓ locked count=1'

# Bob switches back. The checkout succeeds and Alice is named.
env LOTO_AGENT_ID=$BOB
exec git checkout other
stderr '⚠ moved-peer-locks count=1'
stderr 'path=shared.go'
stderr $ALICE
stderr 'alice reading'

exec git rev-parse --abbrev-ref HEAD
stdout 'other'

# loto-ay2k AC 1: `git worktree add` hands post-checkout the all-zero SHA as
# the previous-HEAD arg — there is no previous HEAD in a brand-new worktree.
# That is a birth, not an unreadable diff, and must print nothing at all.
exec git worktree add $WORK/wt1 -b wtbranch
! stderr 'moved=fail-open'
! stderr 'moved-peer-locks'
exec git worktree remove $WORK/wt1

# loto-ay2k AC 2: a genuinely unreadable diff — a ref git's store has never
# heard of, not the zero-SHA birth marker — still warns fail-open. git itself
# never manufactures this shape from a real checkout, so it is called
# directly the way the hook would invoke it.
loto check --moved totally-bogus-ref HEAD 1
stderr 'diff=unreadable moved=fail-open'

-- v2.txt --
changed on the other branch
