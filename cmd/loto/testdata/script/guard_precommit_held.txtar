# .githooks/pre-commit leg 2 (`loto check --held --staged`, loto-7oik): a
# commit whose staged set includes a path this session does not hold a lock
# on is refused, naming the path and handing back the `loto lock` line. This
# is the case leg 1 passes — nobody else holds these files either, which is
# exactly the shape of the cc-plugins 2026-08-10 sweep.
#
# End-to-end through the real dispatcher and a real `git commit`, so the
# hook, the chain runner and the CLI are all under test together.

exec git config core.hooksPath $REALHOOKS

touch mine.go stray.go

env LOTO_AGENT_ID=$BOB
loto lock mine.go -t 'bob: my own file'
stdout '✓ locked count=1'

# Held path alone: commits clean.
exec git add mine.go
exec git commit -m 'bob: a file he holds'
stdout 'a file he holds'

# stray.go is locked by NOBODY — leg 1 has no opinion, leg 2 refuses.
exec git add stray.go
! exec git commit -m 'bob: sweeps a file he never claimed'
stderr '✗ unheld count=1 unlocked=1 peer=0 staged=1'
stderr 'path=stray.go state=unlocked'
stderr 'loto lock'
stderr 'staged paths this session does not hold a lock on'
stderr 'LOTO_GUARD_OVERRIDE=1'

# Advisory-first: LOTO_GATE_MODE=warn prints the same rows as ⚠ and lets the
# commit through, so the firing counter can gather evidence without blocking
# anyone. The rows still reach the committer.
env LOTO_GATE_MODE=warn
exec git commit -m 'bob: warned but allowed'
stderr '⚠ unheld count=1 unlocked=1 peer=0 staged=1'
stderr '⚠ path=stray.go state=unlocked'
env LOTO_GATE_MODE=

exec git log --oneline
stdout 'warned but allowed'
stdout 'a file he holds'

# Taking the lock is the other way through.
touch third.go
loto lock third.go -t 'bob: third'
exec git add third.go
exec git commit -m 'bob: locked first, then committed'
stdout 'locked first, then committed'
