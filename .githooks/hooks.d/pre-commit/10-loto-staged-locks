#!/usr/bin/env sh
#
# 10-loto-staged-locks — refuse a commit whose staged set this session may not
# commit. Two legs, two questions:
#
#   leg 1  `loto check --gate --staged`  does a PEER hold any staged path?
#          (ccp-vx4w, decision nug 682b236fdd2d / 7a2b16d6aaaf)
#   leg 2  `loto check --held --staged`  do *I* hold ALL of them?
#          (loto-7oik)
#
# Leg 2 is the one addition over mcp_agent_mail's guard, which checks staged
# paths against other agents' reservations only. The cc-plugins 2026-08-10
# incident swept a peer's files with ZERO reservations held anywhere — leg 1
# passes that, leg 2 refuses it. A tree-wide `git commit -a` in a shared
# checkout has the same shape.
#
# ‡ Leg 2 ships advisory-first (survey D5): LOTO_GATE_MODE=warn makes it
# print ⚠ rows and exit 0 while the firing counter in loto's events log
# gathers evidence. Promotion of that default is a follow-up bead filed at
# merge, never a timer in this file.
#
# Runs before 50-beads because a refusal should not leave bd half-run — the
# chain stops at the first non-zero exit.
#
# Fail-open: no `loto` on PATH -> skip silently.

command -v loto >/dev/null 2>&1 || exit 0

if [ "${LOTO_GUARD_OVERRIDE:-}" = "1" ]; then
	echo "pre-commit: LOTO_GUARD_OVERRIDE=1 — skipping loto staged-lock guard" >&2
	exit 0
fi

# stderr deliberately NOT merged into the capture (loto-tzmv.8, Codex #246):
# the capture is echoed only on exit 1, so `2>&1` swallowed every fail-open
# notice — the one signal saying the gate did not run. Letting stderr pass
# straight through means the ⚠ row reaches the committer on exits 0 and 3
# too, which is the point of moving it off stdout.
_loto_gate_out=$(loto check --gate --staged)
_loto_gate_exit=$?

if [ "$_loto_gate_exit" -eq 1 ]; then
	echo "$_loto_gate_out" >&2
	echo "pre-commit: refused — staged paths include a peer's live lock/claim" >&2
	echo "pre-commit: override with LOTO_GUARD_OVERRIDE=1 git commit ..." >&2
	exit 1
fi

# Leg 2. Same capture discipline as leg 1: stdout captured, stderr straight
# through so a fail-open notice is never swallowed. Exit 1 is the only
# refusal; 0 (all held, or nothing staged), 2 (unresolvable path) and 3
# (store unreachable) all proceed. In LOTO_GATE_MODE=warn the command itself
# exits 0 after printing ⚠ rows, so the rows must be echoed on exit 0 too —
# otherwise the advisory period produces a counter nobody can see.
_loto_held_out=$(loto check --held --staged)
_loto_held_exit=$?

case "$_loto_held_out" in
"⚠ unheld"*) echo "$_loto_held_out" >&2 ;;
esac

if [ "$_loto_held_exit" -eq 1 ]; then
	echo "$_loto_held_out" >&2
	echo "pre-commit: refused — staged paths this session does not hold a lock on" >&2
	echo "pre-commit: override with LOTO_GUARD_OVERRIDE=1 git commit ..." >&2
	exit 1
fi

# exit 0 (no conflicts) or 3 (gate infra unreachable, fail-open) both proceed
# — only a confirmed refusal (exit 1) blocks.
exit 0
