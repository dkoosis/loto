#!/usr/bin/env sh
#
# 10-loto-staged-locks — refuse a commit whose staged set this session may not
# commit. Two legs, two questions:
#
#   leg 1  `loto check --gate --staged`  does a PEER hold any staged path?
#          (ccp-vx4w, decision nug 682b236fdd2d / 7a2b16d6aaaf)
#   leg 2  `loto check --held --staged`  do *I* hold ALL of them?
#          (loto-7oik)
#
# Leg 2 is the one addition over mcp_agent_mail's guard, which checks staged
# paths against other agents' reservations only. The cc-plugins 2026-08-10
# incident swept a peer's files with ZERO reservations held anywhere — leg 1
# passes that, leg 2 refuses it. A tree-wide `git commit -a` in a shared
# checkout has the same shape.
#
# ‡ LEG 2 IS ADVISORY BY DEFAULT and refuses nothing until asked to (survey
# D5; epic loto-ea8y "New gates ship in warn mode and promote to blocking on
# evidence"). With LOTO_GATE_MODE unset it prints ⚠ rows and exits 0 while
# the firing counter in loto's events log gathers evidence; the same rows
# become a refusal under LOTO_GATE_MODE=block. Promotion of that default is a
# follow-up bead read off the counter, never a timer in this file.
#
# The default lives in `loto check --held` itself, not in an export here, so
# there is one place that decides it — the CLI and the hook cannot drift into
# disagreeing about which mode ships.
#
# Runs before 50-beads because a refusal should not leave bd half-run — the
# chain stops at the first non-zero exit.
#
# Fail-open: no `loto` on PATH -> skip silently.

command -v loto >/dev/null 2>&1 || exit 0

if [ "${LOTO_GUARD_OVERRIDE:-}" = "1" ]; then
	echo "pre-commit: LOTO_GUARD_OVERRIDE=1 — skipping loto staged-lock guard" >&2
	exit 0
fi

# stderr deliberately NOT merged into the capture (loto-tzmv.8, Codex #246):
# the capture is echoed only on exit 1, so `2>&1` swallowed every fail-open
# notice — the one signal saying the gate did not run. Letting stderr pass
# straight through means the ⚠ row reaches the committer on exits 0 and 3
# too, which is the point of moving it off stdout.
_loto_gate_out=$(loto check --gate --staged)
_loto_gate_exit=$?

if [ "$_loto_gate_exit" -eq 1 ]; then
	echo "$_loto_gate_out" >&2
	echo "pre-commit: refused — staged paths include a peer's live lock/claim" >&2
	echo "pre-commit: override with LOTO_GUARD_OVERRIDE=1 git commit ..." >&2
	exit 1
fi

# An exit this leg does not recognize. 0 is a pass, 1 is the refusal above, 3
# is the documented fail-open (loto already said why on stderr, which is not
# captured). Anything else — 2 among them — is a check that did NOT COMPLETE,
# and the commit proceeds because a gate must not become the outage. What it
# may not do is proceed SILENTLY: an unseen exit 2 is how a bypass hides
# (loto-pgio).
if [ "$_loto_gate_exit" -ne 0 ] && [ "$_loto_gate_exit" -ne 3 ]; then
	[ -n "$_loto_gate_out" ] && echo "$_loto_gate_out" >&2
	echo "⚠ pre-commit: loto check --gate exited $_loto_gate_exit — peer-lock check did not complete; commit proceeds unchecked" >&2
fi

# Leg 2. Same capture discipline as leg 1: stdout captured, stderr straight
# through so a fail-open notice is never swallowed. Exit 1 is the only
# refusal; 0 (advisory rows, all held, or nothing staged) and 3 (store
# unreachable) proceed. In the default warn mode the command exits 0 after
# printing ⚠ rows, so the rows are echoed on exit 0 too — otherwise the
# advisory period produces a counter nobody can see.
_loto_held_out=$(loto check --held --staged)
_loto_held_exit=$?

case "$_loto_held_out" in
"⚠ unheld"*) echo "$_loto_held_out" >&2 ;;
esac

if [ "$_loto_held_exit" -eq 1 ]; then
	echo "$_loto_held_out" >&2
	echo "pre-commit: refused — staged paths this session does not hold a lock on" >&2
	echo "pre-commit: override with LOTO_GUARD_OVERRIDE=1 git commit ..." >&2
	exit 1
fi

# ‡ The unrecognized-exit rule, stated rather than fallen into (loto-pgio).
# `loto check --held --staged` no longer exits 2 on a staged path it cannot
# canonicalize — it reports that path as a row — so an exit here that is
# neither 0, 1 nor 3 means the check did not run. The commit still proceeds:
# the gate ships advisory (epic loto-ea8y, "New gates ship in warn mode"), and
# a hook that refuses on its own confusion is a worse failure than the one it
# guards. But it says so, on stderr, with the exit code and whatever the
# command printed — proceeding SILENTLY on an exit nobody understood is how a
# guard bypass survives a year.
if [ "$_loto_held_exit" -ne 0 ] && [ "$_loto_held_exit" -ne 3 ]; then
	[ -n "$_loto_held_out" ] && echo "$_loto_held_out" >&2
	echo "⚠ pre-commit: loto check --held exited $_loto_held_exit — staged-lock check did not complete; commit proceeds unchecked" >&2
fi

# exit 0 (no conflicts), 3 (gate infra unreachable, fail-open) and the reported
# did-not-complete case above all proceed — only a confirmed refusal (exit 1)
# blocks.
exit 0
