#!/usr/bin/env sh
# pre-commit — dispatcher: beads integration (ccp-th5.2, shape B) + loto
# staged-vs-locks guard (ccp-vx4w, decision nug 682b236fdd2d / 7a2b16d6aaaf).
#
# core.hooksPath is .githooks (this file), so bd's own shim in .beads/hooks/
# is NOT invoked by git — that dir is also excluded via .git/info/exclude, so
# it would not survive a fresh clone anyway. This calls bd's public entry
# point directly, best-effort, mirroring bd 1.1.2's own shim timeout/exit-3
# contract.

# loto guard 2: refuse a commit whose staged set reaches a path a peer holds
# a live lock or claim on. `loto check --gate --staged` already implements
# the exact decision (foreign live lock/claim -> deny, naming the holder);
# this just wires it in and adds the escape hatch. Fail-open, matching every
# other dispatcher here: no `loto` on PATH -> skip silently.
if command -v loto >/dev/null 2>&1; then
  if [ "$LOTO_GUARD_OVERRIDE" = "1" ]; then
    echo "pre-commit: LOTO_GUARD_OVERRIDE=1 — skipping loto staged-lock guard" >&2
  else
    # stderr deliberately NOT merged into the capture (loto-tzmv.8, Codex
    # #246): the capture is echoed only on exit 1, so `2>&1` swallowed every
    # fail-open notice — the one signal saying the gate did not run. Letting
    # stderr pass straight through means the ⚠ row reaches the committer on
    # exits 0 and 3 too, which is the point of moving it off stdout.
    _loto_gate_out=$(loto check --gate --staged)
    _loto_gate_exit=$?
    if [ "$_loto_gate_exit" -eq 1 ]; then
      echo "$_loto_gate_out" >&2
      echo "pre-commit: refused — staged paths include a peer's live lock/claim" >&2
      echo "pre-commit: override with LOTO_GUARD_OVERRIDE=1 git commit ..." >&2
      exit 1
    fi
    # exit 0 (no conflicts) or 3 (gate infra unreachable, fail-open) both
    # proceed — only a confirmed foreign live conflict (exit 1) blocks.
  fi
fi

if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  else
    echo "pre-commit: beads hook running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT" >&2
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ "$_bd_exit" -eq 124 ] || { [ "$_bd_used_perl" -eq 1 ] && [ "$_bd_exit" -eq 142 ]; }; then
    echo "pre-commit: beads hook timed out after ${_bd_timeout}s — continuing without beads" >&2
    _bd_exit=0
  fi
  if [ "$_bd_exit" -eq 3 ]; then
    echo "pre-commit: beads database not initialized — skipping" >&2
    _bd_exit=0
  fi
  if [ "$_bd_exit" -ne 0 ]; then exit "$_bd_exit"; fi
fi
