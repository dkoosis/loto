bin/
!.sandbox/bin/
/loto
*.test
*.out
.DS_Store
.snipe/
.claude/tmp/
.claude/worktrees/
.beads/*.db

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Sandbox caches and ephemeral reports
.sandbox/cache/
# Repo-local golangci-lint cache (Makefile GOLANGCI_LINT_CACHE)
.cache/
.sandbox/setup-report.json
.sandbox/baseline.txt

# fo sidecar state (per-run diff classification)
.fo/

# scheduled task runtime lock
.claude/scheduled_tasks.lock
# review-artifact dump dir
docs/feedback/
# local lintbrush quality ledger (sqlite + wal/shm)
.quality/
# jscpd fo-render temp dir
.jscpd-tmp/
report/

# fleet coordination heartbeats (ephemeral)
.team/
# bd worktrees (loto-<bead>/ at repo root) — glob covers all, no per-branch churn
/loto-*/
.aider*

# bd audit residue: passive re-export, Dolt is source of truth. bd rewrites it
# on every field change, so tracking it would leave a dirty tree after any bead
# write. Matches sdlc's .gitignore.
.beads/interactions.jsonl
