{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/gate-file-lock.sh"
          }
        ]
      },
      {
        "matcher": "^(?!Read$|Grep$|Glob$).*$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/tree-hook.sh pre",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/tool-session-end.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!Read$|Grep$|Glob$).*$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/tree-hook.sh post",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(?!Read$|Grep$|Glob$).*$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/tree-hook.sh post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
